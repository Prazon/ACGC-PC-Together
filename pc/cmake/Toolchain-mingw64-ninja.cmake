set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

if(NOT DEFINED MINGW64)
    set(MINGW64 "C:/msys64/mingw64")
endif()
file(TO_CMAKE_PATH "${MINGW64}" MINGW64)

set(CMAKE_C_COMPILER "${MINGW64}/bin/x86_64-w64-mingw32-gcc.exe")
set(CMAKE_CXX_COMPILER "${MINGW64}/bin/x86_64-w64-mingw32-g++.exe")
set(CMAKE_RC_COMPILER "${MINGW64}/bin/windres.exe")
set(CMAKE_AR "${MINGW64}/bin/ar.exe")
set(CMAKE_RANLIB "${MINGW64}/bin/ranlib.exe")
set(CMAKE_STRIP "${MINGW64}/bin/strip.exe")
set(CMAKE_MAKE_PROGRAM "${MINGW64}/bin/ninja.exe" CACHE FILEPATH "Ninja executable")

set(CMAKE_FIND_ROOT_PATH "${MINGW64}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
